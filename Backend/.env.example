PORT=5000
DATABASE_URL="file:../Database/prisma/dev.db"

# Groq API Keys (Add multiple keys comma-separated for automatic failover & rate-limit rotation)
# Example: GROQ_API_KEYS="gsk_key1,gsk_key2,gsk_key3"
GROQ_API_KEYS="gsk_your_first_key_here,gsk_your_second_key_here"

# Or single key fallback:
GROQ_API_KEY="gsk_your_primary_key_here"
