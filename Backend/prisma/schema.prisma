datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Project {
  id           String        @id @default(cuid())
  name         String
  description  String?
  targetDomain String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  tasks        TaskSession[]
}

model TaskSession {
  id        String        @id @default(cuid())
  title     String
  projectId String?
  project   Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model ChatMessage {
  id        String      @id @default(cuid())
  taskId    String
  task      TaskSession @relation(fields: [taskId], references: [id], onDelete: Cascade)
  role      String      // "user" | "assistant"
  content         String?
  attachmentsJson String?     // Serialized AttachedFile[] (code snippets, scope files, artifacts)
  stepsJson       String?     // Serialized AssistantStep[] (reasoning blocks, tool pills, etc.)
  createdAt       DateTime    @default(now())
}

model UserUsage {
  id                  String    @id @default(cuid())
  identifier          String    @unique // email (for account quota), or "deepseek_ip:" + ipHash
  ipHash              String?   // Hashed client IP (SHA-256 with server-side salt)
  deviceHash          String?   // Hashed first-party device identifier (SHA-256 with server-side salt)
  accountEmails       String?   // Comma-separated list of associated account emails in this quota environment
  chatUses            Int       @default(0) // General free chat usage
  deepseekUses        Int       @default(0) // DeepSeek chat usage in active 3-day window
  deepseekWindowStart DateTime? // Timestamp when current 3-day window began
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([ipHash])
  @@index([deviceHash])
}
