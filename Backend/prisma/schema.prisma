datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Project {
  id           String        @id @default(cuid())
  name         String
  description  String?
  targetDomain String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  tasks        TaskSession[]
}

model TaskSession {
  id        String        @id @default(cuid())
  title     String
  projectId String?
  project   Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model ChatMessage {
  id        String      @id @default(cuid())
  taskId    String
  task      TaskSession @relation(fields: [taskId], references: [id], onDelete: Cascade)
  role      String      // "user" | "assistant"
  content         String?
  attachmentsJson String?     // Serialized AttachedFile[] (code snippets, scope files, artifacts)
  stepsJson       String?     // Serialized AssistantStep[] (reasoning blocks, tool pills, etc.)
  createdAt       DateTime    @default(now())
}
