# ==============================================================================
# 🚀 Kairo / HackerAI – Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 🌐 Server & Database
# ------------------------------------------------------------------------------
PORT=5000
DATABASE_URL="file:./prisma/dev.db"

# ------------------------------------------------------------------------------
# 🔑 Groq Multi-Key Failover Pool (Default High-Speed Security Agent)
# ------------------------------------------------------------------------------
# Add one or more Groq API keys. The system auto-rotates and handles rate limits.
GROQ_API_KEY_1=gsk_your_groq_key_1_here
GROQ_API_KEY_2=gsk_your_groq_key_2_here

# ------------------------------------------------------------------------------
# 🧠 CheaperInference API (DeepSeek v4-flash-0731)
# ------------------------------------------------------------------------------
# Platform: https://platform.cheaperinference.com/
CHEAPER_INFERENCE_API_KEY=your_cheaper_inference_api_key_here
CHEAPER_INFERENCE_BASE_URL=https://api.cheaperinference.com/v1
CHEAPER_INFERENCE_MODEL=v4-flash-0731

# Usage limit per user/IP for DeepSeek v4-flash-0731 (Default: 2 uses)
CHEAPER_INFERENCE_MAX_USES_PER_USER=2

# ------------------------------------------------------------------------------
# 🛡️ E2B Cloud MicroVM Sandbox (Optional)
# ------------------------------------------------------------------------------
# If omitted, Kairo automatically uses the local isolated security sandbox.
E2B_API_KEY=
