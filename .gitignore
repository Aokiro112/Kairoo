# ==========================================
# 🛡️ Kairo | Autonomous Cybersecurity Copilot
# Git Ignore Configuration
# ==========================================

# 1. Environment Variables, Secrets & Credentials (CRITICAL)
# ------------------------------------------
.env
.env.*
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local
Backend/.env
Backend/.env.*
Database/.env
Database/.env.*
Frontend/.env
Frontend/.env.*
Frontend/.env.local

# Allow committed templates
!*.env.example
!*.env.template
!*.env.sample

# Private Keys, Certificates & Tokens
*.pem
*.key
*.cert
*.crt
*.pfx
*.keystore

# Cloud Deployment CLI & Caches
.vercel/
.railway/
.docker/
docker-compose.override.yml


# 2. Dependencies & Package Managers
# ------------------------------------------
node_modules/
*/node_modules/
Frontend/node_modules/
Backend/node_modules/
Database/node_modules/
jspm_packages/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnpm-store


# 3. Next.js & Frontend Build Artifacts
# ------------------------------------------
.next/
Frontend/.next/
out/
Frontend/out/
*.tsbuildinfo
Frontend/*.tsbuildinfo
Backend/*.tsbuildinfo
Database/*.tsbuildinfo
.turbo/
.swc/


# 4. TypeScript & Backend Build Outputs
# ------------------------------------------
dist/
Backend/dist/
Database/dist/
build/
*.js.map
*.d.ts.map


# 5. Databases & Local Persistent Storage (SQLite / Prisma)
# ------------------------------------------
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
dev.db
Database/prisma/dev.db
Database/prisma/dev.db-journal
Database/prisma/*.db
Database/prisma/*.db-journal
Backend/prisma/dev.db
Backend/prisma/dev.db-journal
Backend/prisma/prisma/
Backend/prisma/*.db
**/prisma/*.db
**/prisma/*.db-*


# 6. Playwright, Browser Automation & Visual Recon Artifacts
# ------------------------------------------
test-results/
playwright-report/
blob-report/
playwright/.cache/
screenshots/
*.png.tmp
*.jpeg.tmp
*.jpg.tmp
*.trace.zip


# 7. Security Engine, Python & Sandbox Artifacts (Docker / E2B)
# ------------------------------------------
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
sandbox_output/
.pytest_cache/


# 8. Logs, Debug & Runtime Files
# ------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.pid
*.seed
*.pid.lock


# 9. AI Agent Sessions, Cache & Local Harness Runtime
# ------------------------------------------
.system_generated/
.agents-cache/
.agent/
.gemini/
.claude/


# 10. Testing & Coverage Outputs
# ------------------------------------------
coverage/
.nyc_output/
*.lcov


# 11. IDE, OS & System Files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

